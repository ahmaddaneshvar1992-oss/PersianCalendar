<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- اعلان‌ها -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- یادآوری دقیق رویدادها (اپ تقویم مجاز به استفاده از USE_EXACT_ALARM است) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- راه‌اندازی مجدد هشدارها پس از ری‌استارت گوشی -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- استثنا شدن از بهینه‌سازی باتری تا آلارم‌ها حتماً سر وقت اجرا شوند — نسخه ۱.۱۱.۱۱ -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- سرویس پخش اذان در پس‌زمینه — نسخه ۱.۱۱.۷ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- اینترنت: خرید درون‌برنامه‌ای (Google Play Billing) و باز کردن لینک‌ها -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- خرید درون‌برنامه‌ای عضویت ویژه -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- موقعیت برای اوقات شرعی (اختیاری — در صورت نبود، شهر انتخابی استفاده می‌شود) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".PersianCalendarApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.PersianCalendar"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ویجت تقویم -->
        <receiver
            android:name=".widget.CalendarWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_calendar_info" />
        </receiver>

        <!-- یادآوری رویدادها -->
        <receiver
            android:name=".notifications.ReminderReceiver"
            android:exported="false" />

        <!-- موتور یادآور عمومی (آب/دارو/ورزش/شخصی) — نسخه ۱.۱۱ -->
        <receiver
            android:name=".notifications.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- اکشن‌های اعلان یادآور: «انجام شد» و «بعداً یادآوری کن» -->
        <receiver
            android:name=".notifications.ReminderActionReceiver"
            android:exported="false" />

        <!-- اعلان اوقات شرعی -->
        <receiver
            android:name=".notifications.PrayerAlarmReceiver"
            android:exported="false" />

        <!-- سرویس پخش اذان — نسخه ۱.۱۱.۷: صدای اذان هنگام نوتیف حتی با بسته‌بودن برنامه -->
        <service
            android:name=".notifications.AzanPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- تیک روزانه -->
        <receiver
            android:name=".notifications.DailyTickReceiver"
            android:exported="false" />

        <!-- ری‌استارت دستگاه + تغییر ساعت/منطقه زمانی (بازیابی آلارم‌ها — نسخه ۱.۱۱) -->
        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- نسخه ۱.۱۱.۵: متادیتای AdMob حذف شد (تبلیغات کامل از برنامه برداشته شدند) -->
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
